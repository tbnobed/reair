{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Re-Air editorial review tokens extracted from the Guided Review interface. Warm archival surfaces pair with broadcast-console navigation, signal orange review states, aqua references, and compact operational typography.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#e9e4d8" },
      "foreground": { "$value": "#1b2b35" },
      "border": { "$value": "#c8c3b8" },
      "card": { "$value": "#f3eee3" },
      "cardForeground": { "$value": "#1b2b35" },
      "popover": { "$value": "#f3eee3" },
      "popoverForeground": { "$value": "#1b2b35" },
      "primary": {
        "$value": "#d86439",
        "$description": "Signal orange for primary decisions, active review states, and progress."
      },
      "primaryForeground": { "$value": "#fff9ed" },
      "secondary": { "$value": "#1b2b35" },
      "secondaryForeground": { "$value": "#e8e5da" },
      "muted": { "$value": "#e1ded4" },
      "mutedForeground": { "$value": "#64717a" },
      "accent": { "$value": "#2d8290" },
      "accentForeground": { "$value": "#f3eee3" },
      "destructive": { "$value": "#9e3d26" },
      "destructiveForeground": { "$value": "#fff9ed" },
      "input": { "$value": "#9fb0b6" },
      "ring": { "$value": "#d86439" },
      "chart1": { "$value": "#d86439" },
      "chart2": { "$value": "#2d8290" },
      "chart3": { "$value": "#4f7e64" },
      "chart4": { "$value": "#c18b46" },
      "chart5": { "$value": "#1b2b35" },
      "sidebar": { "$value": "#17242d" },
      "sidebarForeground": { "$value": "#d5dfdc" },
      "sidebarBorder": { "$value": "#3b4c55" },
      "sidebarPrimary": { "$value": "#d86439" },
      "sidebarPrimaryForeground": { "$value": "#fff9ed" },
      "sidebarAccent": { "$value": "#263941" },
      "sidebarAccentForeground": { "$value": "#eff2e9" },
      "sidebarRing": { "$value": "#f1a05c" }
    },
    "dark": {
      "background": { "$value": "#111a22" },
      "foreground": { "$value": "#e8e5da" },
      "border": { "$value": "#41515b" },
      "card": { "$value": "#17242d" },
      "cardForeground": { "$value": "#e8e5da" },
      "popover": { "$value": "#203039" },
      "popoverForeground": { "$value": "#eff2e9" },
      "primary": { "$value": "#f1a05c" },
      "primaryForeground": { "$value": "#111a22" },
      "secondary": { "$value": "#263941" },
      "secondaryForeground": { "$value": "#dce7e7" },
      "muted": { "$value": "#203039" },
      "mutedForeground": { "$value": "#9fb0b6" },
      "accent": { "$value": "#2d8290" },
      "accentForeground": { "$value": "#f3eee3" },
      "destructive": { "$value": "#d86439" },
      "destructiveForeground": { "$value": "#fff9ed" },
      "input": { "$value": "#3b4c55" },
      "ring": { "$value": "#f1a05c" },
      "chart1": { "$value": "#f1a05c" },
      "chart2": { "$value": "#58a7b3" },
      "chart3": { "$value": "#79a98b" },
      "chart4": { "$value": "#d2a35f" },
      "chart5": { "$value": "#d86439" },
      "sidebar": { "$value": "#10202a" },
      "sidebarForeground": { "$value": "#d5dfdc" },
      "sidebarBorder": { "$value": "#3b4c55" },
      "sidebarPrimary": { "$value": "#f1a05c" },
      "sidebarPrimaryForeground": { "$value": "#111a22" },
      "sidebarAccent": { "$value": "#263941" },
      "sidebarAccentForeground": { "$value": "#eff2e9" },
      "sidebarRing": { "$value": "#f1a05c" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["IBM Plex Sans", "system-ui", "sans-serif"],
        "$description": "Editorial body and interface typeface."
      },
      "serif": {
        "$value": ["IBM Plex Sans Condensed", "Arial Narrow", "sans-serif"],
        "$description": "Condensed display face for operational headings and labels."
      },
      "mono": {
        "$value": ["IBM Plex Mono", "monospace"],
        "$description": "Identifiers, timecodes, dates, counts, and technical metadata."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Restrained operational radius; controls remain precise rather than soft."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
