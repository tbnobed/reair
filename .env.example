# Copy this file to .env before running Docker Compose.
# Generate both secrets with: openssl rand -hex 32
POSTGRES_DB=reair
POSTGRES_USER=reair
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: seed the first login account on API startup.
# The account is created only if this email does not already exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
APP_PORT=8080